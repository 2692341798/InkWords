POSTGRES_USER=inkwords
POSTGRES_PASSWORD=change_me
POSTGRES_DB=inkwords_db

REDIS_URL=redis://redis:6379/0
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/
RABBITMQ_EXCHANGE=inkwords.events
RABBITMQ_GENERATION_QUEUE=inkwords.generation
RABBITMQ_PARSE_QUEUE=inkwords.parse
RABBITMQ_EXPORT_QUEUE=inkwords.export
EXPORT_ARTIFACTS_DIR=/app/export-artifacts
RABBITMQ_PARSE_QUEUE=inkwords.parse

DEEPSEEK_API_KEY=your_deepseek_api_key
# Optional OpenAI-compatible endpoint override for local mocks or a controlled gateway.
DEEPSEEK_API_URL=
# DeepSeek's current general-purpose model name. This remains unused while
# TEXTBOOK_GENERATION_PROVIDER=fake.
DEEPSEEK_MODEL=deepseek-v4-flash
# Optional mastery grading override; Compose defaults to DEEPSEEK_MODEL.
# Standalone review-service also needs MASTERY_DEEPSEEK_API_KEY explicitly.
MASTERY_DEEPSEEK_MODEL=
MASTERY_DEEPSEEK_API_KEY=
# Optional local-evaluation-v1: v6 text uses low reasoning, code disables it;
# both allow 6000 output tokens within a 60-second task. Requires the evaluated
# deepseek-v4-flash model. Blank preserves legacy options. Calls remain explicit.
# local-evaluation-v2 adds task/source ID enums and contiguous quote guidance;
# v1 request hashes remain unchanged. Scoring still requires explicit review/apply.
MASTERY_ASSESSMENT_PROFILE=
# Textbook candidates remain deterministic and offline by default. To opt in
# to a provider, set TEXTBOOK_GENERATION_PROVIDER to deepseek or openai and
# provide only the matching process environment key; keys are never stored in
# the database or returned by an API.
TEXTBOOK_GENERATION_PROVIDER=fake
# Standard candidates use Flash. Reserve Pro for the small set of blueprint,
# core-mechanism, and editorial-review tasks selected by TaskModelPolicy.
TEXTBOOK_STANDARD_MODEL=deepseek-v4-flash
TEXTBOOK_CORE_MODEL=deepseek-v4-pro
# Whole sample chapters can exceed the legacy 45-second adapter timeout.
# Keep this bounded between 30s and 30m.
TEXTBOOK_GENERATION_REQUEST_TIMEOUT=15m
# Optional outside Compose: private rejected JSON, separate from accepted cache.
# Compose mounts its service-owned rejected-drafts volume automatically.
TEXTBOOK_REJECTED_DRAFTS_DIR=
OPENAI_API_KEY=
# Generation workers return structured task results by default. Set to legacy only for emergency rollback.
INKWORDS_TASK_PERSISTENCE_MODE=task_only
TEXTBOOK_TEACHING_ARTIFACTS_DIR=/app/teaching-artifacts
TEXTBOOK_TEACHING_GO_VERSION=go1.26.8
# Optional operator-owned catalog inside a read-only prepared dependency mount.
# Empty disables package choices; it never downloads or activates dependencies.
TEXTBOOK_DEPENDENCY_CATALOG_FILE=
TEXTBOOK_TEACHING_ARTIFACT_VERIFICATION_ENABLED=false
LEARNER_ARTIFACT_VERIFICATION_ENABLED=false
TEXTBOOK_RUNNER_IMAGE_DIGEST=
# Frozen whole-book DOCX uses the reviewed reference embedded in export-service.
# Enable PDF only after verifying Chromium sandboxing in the target runtime.
TEXTBOOK_PANDOC_BIN=/usr/bin/pandoc
TEXTBOOK_REFERENCE_DOCX=/app/assets/publishing/inkwords-reference.docx
TEXTBOOK_CHROMIUM_BIN=
# Optional closed Fontconfig source set; enabled by docker-compose.textbook-pdf.yml.
# Requires the exporter image's reviewed font links and exact reviewed file hashes.
TEXTBOOK_PDF_FONT_PROFILE=

# Optional fixed compatibility owner for legacy local data. Leave empty to
# resolve the existing local workspace owner automatically.
DEV_AUTH_USER_ID=

OBSIDIAN_REST_API_BASE_URL=https://obsidian-bridge:27125
OBSIDIAN_REST_API_KEY=your_obsidian_rest_api_key
OBSIDIAN_REST_API_CERT_PATH=
OBSIDIAN_REST_API_INSECURE_SKIP_VERIFY=true

OBSIDIAN_WIKI_DIR=wiki
OBSIDIAN_VAULT_PATH=/absolute/path/to/your/obsidian/vault

# review-service reads immutable approved textbook projections from this fixed local origin.
CORE_API_URL=http://core-api:8080
COURSE_RUNNER_URL=http://course-runner:8080
REVIEW_SERVICE_URL=http://review-service:8080
