# Copy to a temporary shell environment; do not put credentials in this file.
COMPOSE_PROJECT_NAME=inkwords-e2e-local
E2E_RUN_ID=local
E2E_PORT=18080
E2E_VAULT_PATH=/tmp/inkwords-e2e-local/vault
INKWORDS_E2E_BASE_URL=http://127.0.0.1:18080
E2E_AUTH_MODE=ui
E2E_EXTERNAL_MODE=stub
VITE_AUTH_BYPASS=true
# Supply unique, disposable values in your temporary shell environment.
JWT_SECRET=
